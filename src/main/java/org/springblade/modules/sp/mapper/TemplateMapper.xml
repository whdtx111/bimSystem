<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.TemplateMapper">

    <!--<resultMap id="TemplateDOResultMap" type="org.springblade.modules.sp.entity.TemplateDO">-->
        <!--<id property="id" column="id"/>-->
        <!--<result property="pid" column="pid"/>-->
        <!--<result property="name" column="name"/>-->
        <!--<result property="type" column="type"/>-->
        <!--<result property="branchId" column="branch_id"/>-->
        <!--<result property="ranknum" column="ranknum"/>-->
        <!--<result property="detail" column="detail"/>-->
        <!--<result property="status" column="status"/>-->
        <!--<result property="modifyUser" column="modify_user"/>-->
        <!--<result property="modifyTime" column="modify_time" jdbcType="TIMESTAMP"/>-->
    <!--</resultMap>-->

    <!--查找数据模板树节点列表-->
    <select id="getTemplateList" resultType="org.springblade.modules.sp.entity.TemplateDO">
        SELECT * FROM sp_template_list WHERE branch_id = #{branchId} and stream_id = #{streamId} and status != 9;
    </select>

    <select id="getById" resultType="org.springblade.modules.sp.entity.TemplateDO">
        SELECT * FROM sp_template_list WHERE id = #{id} and status != 9;
    </select>
    <!--插入新templateDO-->
    <insert id="addTemplateNode" parameterType="org.springblade.modules.sp.entity.TemplateDO">
        insert into sp_template_list(id,pid,wbs_group,name,type,branch_id,stream_id,detail,status,modify_user,modify_time,ranknum)
        values (#{id},#{pid},#{wbsGroup},#{name},#{type},#{branchId},#{streamId},#{detail},#{status},#{modifyUser},#{modifyTime},#{ranknum});
    </insert>
    <!--更新sp_template_list-->
    <update id="updateTemplateNode" parameterType="org.springblade.modules.sp.entity.TemplateDO">
        update sp_template_list
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="pid != null">
                pid = #{pid},
            </if>
            <if test="wbsGroup != null">
                wbs_group = #{wbsGroup},
            </if>
            <if test="detail != null">
                detail = #{detail},
            </if>
            <if test="ranknum != null">
                ranknum = #{ranknum},
            </if>
            modify_user = #{modifyUser},
            modify_time = #{modifyTime}
        </set>
        where id = #{id}
        and
        status != 9;
    </update>
    <!--逻辑删除sp_template_list-->
    <update id="deleteTemplateNode" parameterType="java.lang.String">
         update sp_template_list
         set status = 9
         where id = #{id};
    </update>

</mapper>
