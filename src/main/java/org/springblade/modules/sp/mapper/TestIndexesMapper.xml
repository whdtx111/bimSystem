<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.TestIndexesMapper">
    <resultMap id="testIndexesResultMap" type="org.springblade.modules.sp.entity.TestIndexes">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="auth" property="auth"/>
        <result column="status" property="status"/>
        <result column="created_user" property="createdUser"/>
        <result column="source" property="source"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 查询单条记录 -->
    <select id="getTestIndexesById" resultMap="testIndexesResultMap">
        SELECT * FROM sp_test_indexes WHERE id = #{id}
    </select>

    <!-- 查询所有记录 -->
    <select id="getAll" resultMap="testIndexesResultMap">
        SELECT * FROM sp_test_indexes ORDER BY create_time DESC
    </select>

    <!-- 根据条件查询 -->
    <select id="filterTestIndexes" resultMap="testIndexesResultMap">
        SELECT * FROM sp_test_indexes
        <where>
            1=1
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="auth != null and auth != ''">
                AND auth = #{auth}
            </if>
            <if test="source != null and source != ''">
                AND source = #{source}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 插入记录 -->
    <insert id="addTestIndexes" parameterType="org.springblade.modules.sp.entity.TestIndexes">
        INSERT INTO sp_test_indexes (
            id, name, auth, status, created_user, source, description,
            create_time
        ) VALUES (
            #{id}, #{name}, #{auth}, #{status}, #{createdUser}, #{source}, #{description},
            #{createTime}
        )
    </insert>

    <!-- 批量插入 -->
    <insert id="insertTestIndexesBatch" parameterType="java.util.List">
        INSERT INTO sp_test_indexes (
            id, name, auth, status, created_user, source, description,
            create_time
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.id}, #{item.name}, #{item.auth}, #{item.status}, #{item.createdUser},
                #{item.source}, #{item.description}, #{item.createTime}
            )
        </foreach>
    </insert>

    <!-- 更新记录 -->
    <update id="updateTestIndexes" parameterType="org.springblade.modules.sp.entity.TestIndexes">
        UPDATE sp_test_indexes
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="auth != null">auth = #{auth},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdUser != null">created_user = #{createdUser},</if>
            <if test="source != null">source = #{source},</if>
            <if test="description != null">description = #{description},</if>
            create_time = #{createTime}
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除记录 -->
    <delete id="deleteTestIndexesById" parameterType="string">
        DELETE FROM sp_test_indexes WHERE id = #{id}
    </delete>
</mapper>
