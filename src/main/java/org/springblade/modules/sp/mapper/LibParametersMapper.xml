<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.LibParametersMapper">

    <select id="getById" resultType="org.springblade.modules.sp.entity.LibParameters">
        select * from sp_lib_parameters where id = #{id};
    </select>

    <select id="getAllLibParameters" resultType="org.springblade.modules.sp.entity.LibParameters">
        select * from sp_lib_parameters ;
    </select>

    <select id="getAllLibParametersByWbsCode" resultType="org.springblade.modules.sp.entity.LibParameters">
        select * from sp_lib_parameters where wbs_code = #{wbsCode};
    </select>

    <select id="filterLibParameters" resultType="org.springblade.modules.sp.entity.LibParameters">
    SELECT * FROM sp_lib_parameters
    WHERE 1=1
    <if test="wbsCode != null and wbsCode !=''">
        AND wbs_code = #{wbsCode}
    </if>
        <if test="tempId != null and tempId !=''">
            AND temp_id = #{tempId}
        </if>
        <if test="libId != null and libId !=''">
            AND lib_id = #{libId}
        </if>
    </select>

    <insert id="addLibParameters" parameterType="org.springblade.modules.sp.entity.LibParameters">
        insert into sp_lib_parameters(id,lib_id,name,value,unit,wbs_code,temp_id)
        values (#{id},#{libId},#{name},#{value},#{unit},#{wbsCode},#{tempId});
    </insert>

    <update id="updateLibParameters" parameterType="org.springblade.modules.sp.entity.LibParameters">
        update sp_lib_parameters
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="value != null">
                value = #{value},
            </if>
            <if test="unit != null">
                unit = #{unit},
            </if>
        </set>
        where id = #{id};
    </update>

    <delete id="deleteLibParameters" parameterType="java.lang.String">
        delete from sp_lib_parameters where id = #{id};
    </delete>
</mapper>
