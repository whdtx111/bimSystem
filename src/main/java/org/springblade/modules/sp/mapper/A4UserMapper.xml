<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.A4UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="a4UserResultMap" type="org.springblade.modules.sp.entity.A4User">
        <id column="id" property="id"/>
        <result column="sneb_user_code" property="snebUserCode"/>
        <result column="sneb_name" property="snebName"/>
        <result column="sneb_email" property="snebEmail"/>
        <result column="sneb_phone" property="snebPhone"/>
    </resultMap>

    <select id="getListA4User" resultType="org.springblade.modules.sp.entity.A4User">
        SELECT
        *
        FROM
        sp_a4_user_v1
    </select>


</mapper>
