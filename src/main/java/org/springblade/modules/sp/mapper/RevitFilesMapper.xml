    <select id="getById" resultType="org.springblade.modules.sp.entity.RevitFiles">
        select * from sp_revit_files where id = #{id};
    </select>

    <select id="getByName" resultType="org.springblade.modules.sp.entity.RevitFiles">
        select * from sp_revit_files where status != 9 and stream_id = #{streamId} and branch_id = #{branchId} and commit_id = #{commitId} and sp_revit_files.name = #{name};
    </select>

    <select id="searchFilter" resultType="org.springblade.modules.sp.entity.RevitFiles">
        select * from sp_revit_files where status != 9 and stream_id = #{streamId} and branch_id = #{branchId} and commit_id = #{commitId};
    </select>

    <insert id="addRevitFile" parameterType="org.springblade.modules.sp.entity.RevitFiles">
        INSERT INTO sp_revit_files (id, stream_id, branch_id, commit_id, name, type, file_url, size,master_file_name, modify_user, modify_time, status)
        VALUES (#{id}, #{streamId}, #{branchId}, #{commitId}, #{name}, #{type}, #{fileUrl}, #{size},#{masterFileName}, #{modifyUser}, #{modifyTime}, #{status})
    </insert>
    <!-- 根据ID删除记录 -->
    <delete id="deleteRevitFileById" parameterType="string">
        DELETE FROM sp_revit_files WHERE id = #{id}
    </delete>

</mapper>
