<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.ExpInstancesMapper">

    <resultMap id="ExpInstancesResultMap" type="org.springblade.modules.sp.entity.ExpInstances">
        <id property="id" column="id"/>
        <result property="objId" column="objId"/>
        <result property="streamId" column="streamId"/>
        <result property="branchId" column="branchId"/>
        <result property="type" column="type"/>
        <result property="level" column="level" typeHandler="org.springblade.modules.sp.utils.JsonTypeHandler"/>
        <result property="units" column="units"/>
        <result property="slope" column="slope"/>
        <result property="family" column="family"/>
        <result property="category" column="category"/>
        <result property="elementId" column="elementId"/>
        <result property="parameters" column="parameters" typeHandler="org.springblade.modules.sp.utils.JsonTypeHandler"/>
        <result property="phaseCreated" column="phaseCreated"/>
        <result property="smartLinkType" column="smartLinkType"/>
        <result property="applicationId" column="applicationId"/>
        <result property="slopeDirection" column="slopeDirection"/>
        <result property="builtInCategory" column="builtInCategory"/>
        <result property="isRevitLinkedModel" column="isRevitLinkedModel"/>
        <result property="materialQuantities" column="materialQuantities" typeHandler="org.springblade.modules.sp.utils.JsonTypeHandler"/>
        <result property="createAt" column="createdAt" jdbcType="TIMESTAMP"/>
    </resultMap>

