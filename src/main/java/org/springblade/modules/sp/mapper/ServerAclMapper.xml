<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.ServerAclMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="serverAclResultMap" type="org.springblade.modules.sp.entity.ServerAcl">
        <id column="userId" property="userId"/>
        <result column="role" property="role"/>
    </resultMap>


    <select id="selectServerAclPage" resultMap="serverAclResultMap">
        select * from server_acl where is_deleted = 0
    </select>

</mapper>
