<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.SnapshotMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="snapshotResultMap" type="org.springblade.modules.sp.entity.Snapshot">
        <id column="id" property="id"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="user_id" property="userId"/>
        <result column="snapshot_name" property="snapshotName"/>
        <result column="snapshot_type" property="snapshotType"/>
        <result column="color_value" property="colorValue"/>
        <result column="remark" property="remark"/>
        <result column="obj_id" property="objId"/>
        <result column="stream_id" property="streamId"/>
        <result column="commit_id" property="commitId"/>
        <result column="snapshot_uid" property="snapshotUid"/>
    </resultMap>


    <select id="selectSnapshotPage" resultMap="snapshotResultMap">
        select * from sp_snapshot where is_deleted = 0
    </select>

    <select id="getSnapshot" resultType="org.springblade.modules.sp.dto.SnapshotDTO">
        SELECT DISTINCT ON
            ( snapshot.snapshot_uid ) snapshot_uid,
            snapshot.snapshot_name,
            snapshot.commit_id,
            snapshot.create_time createTime,
            snapshot.stream_id,
            snapshot.user_id,
            snapshot.remark,
            u."name" user_name
        FROM
            sp_snapshot AS snapshot
            LEFT JOIN ( SELECT "id", "name" FROM users ) AS u ON u."id" = snapshot.user_id
        WHERE
            snapshot.is_deleted = 0
        AND
            snapshot.snapshot_type = '1'
        AND
            snapshot.commit_id = #{commitId};

    </select>

</mapper>
