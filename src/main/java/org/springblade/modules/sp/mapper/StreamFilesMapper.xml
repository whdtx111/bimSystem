<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sp.mapper.StreamFilesMapper">

    <resultMap id="StreamFilesResultMap" type="org.springblade.modules.sp.entity.StreamFiles">
        <id property="id" column="id"/>
        <result property="objectId" column="object_id" typeHandler="org.springblade.modules.sp.utils.VarcharArrayTypeHandler"/>
        <result property="streamId" column="stream_id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="fileUrl" column="file_url"/>
        <result property="size" column="size"/>
        <result property="modifyUser" column="modify_user"/>
        <result property="modifyTime" column="modify_time" jdbcType="TIMESTAMP"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="getById" resultMap="StreamFilesResultMap">
       SELECT * FROM sp_stream_files WHERE id = #{id} and status != 9;
   </select>

    <select id="getFile" resultMap="StreamFilesResultMap">
       SELECT * FROM sp_stream_files WHERE stream_id = #{streamId} and name = #{name} and status != 9;
   </select>

   <select id="getAllStreamFiles" resultMap="StreamFilesResultMap">
       SELECT * FROM sp_stream_files WHERE stream_id = #{streamId} and status != 9;
   </select>

    <select id="getStreamFiles" resultMap="StreamFilesResultMap">
       SELECT * FROM sp_stream_files WHERE stream_id = #{streamId} and type = #{type} and status != 9;
   </select>

    <select id="getStreamFileByStreamId" resultMap="StreamFilesResultMap">
            SELECT * FROM sp_stream_files WHERE stream_id = #{streamId} and name = #{name} and status != 9 order by modify_time desc limit 1;
    </select>

    <insert id="addStreamFiles" parameterType="org.springblade.modules.sp.entity.StreamFiles">
        insert into sp_stream_files(id,object_id,stream_id,name,type,file_url,size,modify_user,modify_time,status)
        values (#{id},'{}',#{streamId},#{name},#{type},#{fileUrl},#{size},#{modifyUser},#{modifyTime},#{status});
    </insert>

    <delete id="deleteStreamFiles" parameterType="java.lang.String">
          delete from sp_stream_files where id = #{id};
    </delete>

    <update id="linkObjects">
        update sp_stream_files set object_id = #{objectId,typeHandler=org.springblade.modules.sp.utils.VarcharArrayTypeHandler} where id = #{id} and status != 9;
    </update>

    <update id="rename" parameterType="org.springblade.modules.sp.entity.StreamFiles">
        update sp_stream_files set name = #{name} where id = #{id} and status != 9;
    </update>
</mapper>
