        this.branchId = branchId;
        this.commitId = commitId;
        this.loiNow = loiNow;
        this.lodNow = lodNow;
        this.library = library;
    }
    public ElementLibrary() {
        this.id = UUID.randomUUID().toString();
        this.modifyTime = new Date();
    }
}
